<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\gadaviral.ico</ApplicationIcon>
    <AssemblyName>GADAVIRAL</AssemblyName>
    <RootNamespace>GADAVIRAL</RootNamespace>
    <Version>1.0.0</Version>
    <Product>GADAVIRAL — Dangme &amp; Ga Online Social Community</Product>
    <Company>GADAVIRAL</Company>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Resource Include="Assets\gadaviral.png" />
    <Resource Include="Assets\avatars\*.png" />
  </ItemGroup>

</Project>
