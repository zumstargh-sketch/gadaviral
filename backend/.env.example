# ──────────────────────────────────────────────────────────────────────────────
# GADAVIRAL API — environment configuration (copy to .env and fill in)
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
# Set true when behind a reverse proxy (Render, Nginx, Cloudflare) so the
# rate limiter and audit logs see the real client IP
TRUST_PROXY=false
API_BASE_URL=http://localhost:4000
# Public web origin (CORS + OAuth redirect targets, comma separated)
WEB_APP_URL=http://localhost:5173
# Comma separated list of allowed origins (website, preview, production)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://www.gadaviral.com

# PostgreSQL (local dev default matches scripts/dev-db.mjs embedded server)
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/gadaviral?client_encoding=UTF8  # port 5432 works on most systems
DATABASE_SSL=false
DB_POOL_MAX=20

# JWT / sessions
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)
REFRESH_COOKIE_NAME=gadv_refresh

# Google OAuth / OpenID Connect (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_ID=
# Allowed Google hosted domains (empty = any)
GOOGLE_HD=

# SMTP (authentication email sender: admin@gadaviral.com)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@gadaviral.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=admin@gadaviral.com
SMTP_FROM_NAME=GADAVIRAL
# When true and SMTP is not configured, auth emails are logged to console/outbox (DEV ONLY)
SMTP_DEV_MODE=true

# Email verification behaviour
EMAIL_VERIFY_TOKEN_TTL=86400      # seconds (24h)
EMAIL_OTP_TTL=600                 # seconds (10 min)
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_RESEND_COOLDOWN=60          # seconds
PASSWORD_RESET_TOKEN_TTL=3600     # seconds (1h)

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
BCRYPT_ROUNDS=12                  # informational (scrypt used via node:crypto)

# Media storage (local driver; STORAGE_DRIVER=s3 for production object storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
STORAGE_PUBLIC_BASE=/media
MAX_UPLOAD_MB=25
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_MIME=video/mp4,video/webm

# Push notifications (FCM v1)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Moderation (optional external AI service; local wordlist always active)
MODERATION_API_URL=
MODERATION_API_KEY=

# Demo seed
DEMO_SEED_BATCH=auto              # auto = generate a fresh batch id per run

# ──────────────────────────────────────────────────────────────────────────────
# PRODUCTION (Render Web Service) — see docs/DEPLOY-RENDER.md
# Set these in the Render dashboard; never commit real values.
# ──────────────────────────────────────────────────────────────────────────────
# NODE_ENV=production
# TRUST_PROXY=true
# API_BASE_URL=https://YOUR-RENDER-BACKEND-URL.onrender.com
# WEB_APP_URL=https://www.gadaviral.com
# CORS_ORIGINS=https://www.gadaviral.com,https://gadaviral.com,http://localhost:4000,http://localhost:5173
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>   (Render PostgreSQL, exact existing URL)
# DATABASE_SSL=true
# DB_POOL_MAX=10
# JWT_ACCESS_SECRET=<same strong secret as everywhere else>
# GOOGLE_CALLBACK_URL=https://YOUR-RENDER-BACKEND-URL.onrender.com/api/v1/auth/google/callback
# SMTP_DEV_MODE=false
# STORAGE_LOCAL_DIR=/opt/data/storage   (Render Persistent Disk mount path)

