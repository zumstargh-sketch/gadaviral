{
  "name": "gadaviral-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GADAVIRAL API — Ga & Dangme social community backend (Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "migrate:prod": "node dist/src/db/migrate.js up",
    "start:prod": "node dist/src/db/migrate.js up && node dist/src/index.js",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:status": "tsx src/db/migrate.ts status",
    "seed:demo": "tsx seeds/run-seed.ts",
    "seed:demo:force": "tsx seeds/run-seed.ts --force",
    "demo:wipe": "tsx seeds/run-wipe.ts",
    "demo:verify": "tsx seeds/run-verify.ts",
    "demo:stats": "tsx seeds/stats.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.4",
    "postgres": "^3.4.7",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.0",
    "zod": "^4.0.5"
  },
  "optionalDependencies": {
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "^17.4.0-beta.15",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.14",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "^17.4.0-beta.15",
    "supertest": "^7.1.3",
    "tsx": "^4.2.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  }
}
